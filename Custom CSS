/* CREATE A COLOR SECTION THAT TAKES UP 66% OF THE SCREEN */
.custom-narrow-section .container {
    max-width: 66% !important; 
}

a.slide-image.search_image {
    overflow: visible !important;
}

/* CENTER THE TEXT OF A MULTI-ROW COLUMN ACROSS ALL COLUMNS */
.flex-card-column {
    position: relative !important;
    padding-bottom: 25px !important; 
}

.flex-card-column .avia-button-wrap {
    position: absolute !important;
    left: 0 !important;
    width: 100% !important;
    margin: 0 !important;
}

a.search_image .image-overlay.overlay-type-extern {
    left: 0 !important;
}

/* PREVENTS COLLAPSE WHEN NO HEIGHT IS ESTABLISHED */
#top.search-results .small-preview {
    width: 50% !important;
    height: auto !important;
}

.header_color .av_ajax_search_title {
    color: #f9f6f0 !important;
}

/* CHANGE THE COLORS OF THE SEARCH BOX IN HEADER*/
#top #s {
    color: #000000 !important;
    background-color: #f9f6f0 !important;
}

/* HIDE POST META (DATE, AUTHOR, COMMENTS, CATEGORIES) */
.avia-content-slider .slide-meta,
.avia-content-slider .blog-categories,
.template-blog .post-meta-infos,
.avia-builder-el-av_blog .post-meta-infos {
    display: none !important;
}

/* HIDE POST EXCERPTS */
.avia-content-slider .slide-entry-excerpt,
.avia-builder-el-av_blog .entry-content {
    display: none !important;
}

.av-masonry-date {
    display: none !important;
}

#top .av-special-heading .special-heading-inner-border,
body .av-special-heading.elegant-centered .av-special-heading-tag .heading-wrap::before,
body .av-special-heading.elegant-centered .av-special-heading-tag .heading-wrap::after {
    display: none;
}

/* ELIMINATE THE BORDER BETWEEN SECTIONS */
#main > .container_wrap {
    border: none;
}

/* NO MARGINS IN ICONBOX */
.iconbox {
    margin-bottom: 0 !important;
}

/* 3% HORIZONTAL GAP FOR BLOG POST IMAGES (IN-POST GALLERIES & ALIGNED IMAGES) */
.single-post .entry-content .gallery .gallery-item,
.single-post .entry-content .wp-block-gallery .wp-block-image,
.single-post .entry-content img.alignleft {
    margin-right: 3% !important;
}

/* FONT SIZE FOR POST TITLES */
.grid-entry-title,
.slide-entry-title {
    font-size: 15px !important;
}

/* REDUCE SPACING BETWEEN BLOG POST IMAGES */
.avia-content-slider .slide-image {
    margin-bottom: 5px !important;
}

/* CLOSE GAP BETWEEN BLOG POST AND TITLE */
.avia-content-slider .slide-content .slide-entry-title {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

/* REDUCE GAP BETWEEN A 2 ROW POST TITLE */
.avia-content-slider .entry-content-header {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

/* KEEP 16:9 IMAGE RATIO */
.single-post .big-preview img,
.archive .big-preview img,
.blog .big-preview img,
.avia-content-slider .slide-image img {
    aspect-ratio: 16 / 9;
    width: 100%;
    height: auto;
    object-fit: cover;
}

/* FULL SIZE IMAGES WHEN OPENED */
.mfp-image-holder .mfp-content {
    max-width: 100% !important;
    width: 100% !important;
}

/* FIX IMAGE AND BORDERS IN LIGHTBOX IMAGE VIEW */
.mfp-image-holder img.mfp-img {
    max-width: 95vw !important;
    max-height: 95vh !important;
    width: auto !important;
    height: auto !important;
    padding: 20px 0 !important;
    box-sizing: border-box;
}

.mfp-bottom-bar {
    max-width: 95vw !important;
    margin-top: -30px !important;
}

/* CHANGE COLOR OF ICON ON LIGHTBOX PREVIEW */
.image-overlay .image-overlay-inside::before {
    display: none !important;
}

/* FIX HERO IMAGE SECTIONS AND ADD PHOTO CREDIT IN THE BOTTOM CORNER */
.hero-credit-section .container {
    position: relative;
    min-height: 75vh;
}

.hero-credit-section .hero-image-credit {
    position: absolute;
    bottom: 12px;
    right: 15px;
    font-size: 11px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.45);
    padding: 3px 8px;
    border-radius: 4px;
    line-height: 1.3;
    z-index: 5;
    pointer-events: auto;
}

.hero-credit-section .hero-image-credit a {
    color: #f9f6f0;
    text-decoration: underline;
}

/* ADD A CURVE AND BORDER SIZE TO A COLUMN */
#top .my-curved-post-border {
    border: 2px solid #cc5500;       /* BORDER THICKNESS */
    border-radius: 20px;      /* CURVE SIZE */
    overflow: hidden;          /* HIDES IMAGE IN CURVE */
}

/* HIDE THE HOME LINK WHEN ON THE HOME PAGE */
body.home .current-menu-item {
    display: none !important;
}

/* CHANGE THE BOTTOM MARGIN OF BLOG POSTS TO 0 */
.custom-blog-grid {
    margin-bottom: 0px !important;
}

/* CHANGE THE SPECIAL HEADER LOWER MARGIN TO 20PX */
.custom-heading-spacing {
    margin-bottom: 20px !important;
}

/* CHANGE THE BACKGROUND COLOR OF A COLOR SECTION */
.avia-section.custom-background-section {
    background-color: #fdf5e6 !important;
}

/*CHANGE GAP BELOW AN ICON TO 5PX */
.custom-icon-gap {
    margin-bottom: 5px !important;
}
.custom-link-pull p {
    margin-top: -10px !important; 
}
/* CHANGE THE COLOR OF HEADER FONT */
.custom-header-font .av-special-heading-tag {
  color: #f9f6f0 !important; 
}
#top #socket .social_bookmarks li a {
    color: #f9f6f0 !important;
    opacity: 1 !important;
}

/* FIX FULL WIDTH MENU ON MOBILE & STACK CARDS (Merged) */
@media only screen and (max-width: 767px) {
    /* Enfold Fullwidth Submenu / List Menu links */
    .av-subnav-menu > li > a,
    .av-subnav-menu li a .avia-menu-text,
    .avia-menu.av_menu_icon_beside li a {
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

    #home-hero {
        min-height: 300px !important;
    }
    
    /* Stack cards */
    .responsive #top .avia-content-slider .slide-entry.av_one_half,
    .responsive #top .avia-content-slider .slide-entry.av_one_third,
    .responsive #top .avia-content-slider .slide-entry.av_one_fourth {
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: 15px !important;
        clear: both !important;
        float: none !important;
        display: block !important;
    }

    /* Remove the bottom margin from the final entry in the list */
    .responsive #top .avia-content-slider .slide-entry:last-child {
        margin-bottom: 0 !important;
    }
}

/* FIX BLOG POST COLUMNS TO HAVE 3% SPACING */
@media only screen and (min-width: 768px) {
    /* 2 Columns: 48.5% width + 3% margin = 100% total */
    .responsive #top .avia-content-slider .slide-entry.av_one_half {
        width: 48.5% !important;
        margin-left: 3% !important;
        clear: none !important;
    }
    .responsive #top .avia-content-slider .slide-entry.av_one_half.first {
        margin-left: 0 !important;
        clear: both !important;
    }

    /* 3 Columns: 31.33% width + 3% margin (x2) = ~100% total */
    .responsive #top .avia-content-slider .slide-entry.av_one_third {
        width: 31.33% !important;
        margin-left: 3% !important;
        clear: none !important;
    }
    .responsive #top .avia-content-slider .slide-entry.av_one_third.first {
        margin-left: 0 !important;
        clear: both !important;
    }

    /* 4 Columns: 22.75% width + 3% margin (x3) = 100% total */
    .responsive #top .avia-content-slider .slide-entry.av_one_fourth {
        width: 22.75% !important;
        margin-left: 3% !important;
        clear: none !important;
    }
    .responsive #top .avia-content-slider .slide-entry.av_one_fourth.first {
        margin-left: 0 !important;
        clear: both !important;
    }
}

/* INSURE ALL BACKGROUND IMAGES ARE SET TO FIXED */
.avia-section {
    background-attachment: fixed !important;
}

/* CUSTOMIZE THE IMAGE GALLERY GAPS */
/* Custom 3-Column Gallery: Spacing & Borderless (Ignores elements with 'default-gallery' class) */
#top .avia-gallery:not(.default-gallery) .avia-gallery-thumb {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    column-gap: 3% !important;
    row-gap: 25px !important;
}

/* Responsive adjustment for mobile screens */
@media only screen and (max-width: 767px) {
    #top .avia-gallery:not(.default-gallery) .avia-gallery-thumb {
        grid-template-columns: 1fr !important;
    }
}

/* Forces images to fill the grid, removing default Enfold borders and padding */
#top .avia-gallery:not(.default-gallery) .avia-gallery-thumb a {
    margin: 0 !important; 
    width: 100% !important;
    border: none !important; 
    padding: 0 !important; 
    background: transparent !important;
}

/* Ensures the image element itself has no lingering borders and fits the column */
#top .avia-gallery:not(.default-gallery) .avia-gallery-thumb img {
    border: none !important;
    width: 100% !important;
    height: auto !important;
}

/* --- ENFOLD SEARCH RESULTS: FOOLPROOF 3-COLUMN LAYOUT --- */
/* 1. Forces the individual search result posts to be exactly 1/3 width */
.template-search article.post-entry {
    width: 31.33% !important;
    float: left !important;
    margin: 0 3% 25px 0 !important;
    clear: none !important;
    padding: 0 !important;
}

/* 2. Removes the right margin on every 3rd item so the row fits */
.template-search article.post-entry:nth-of-type(3n) {
    margin-right: 0 !important;
}

/* 3. Forces a new row after every 3 items to keep the grid clean */
.template-search article.post-entry:nth-of-type(3n+1) {
    clear: both !important;
}

/* 4. Formats the featured image to fill its new 31% column */
.search-result-thumb {
    display: block !important;
    float: none !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 0 15px 0 !important;
}

.search-result-thumb img {
    width: 100% !important;
    height: auto !important; /* Forces uniform height so columns don't break */
    object-fit: cover !important; /* Prevents stretching */
    display: block !important;
    border-radius: 4px;
}

/* 5. Hides the counter, excerpt, and date entirely */
.search-result-counter,
.template-search article.post-entry .entry-content,
.template-search article.post-entry .post-meta-infos {
    display: none !important;
}

/* 6. Centers the title directly under the image */
.template-search article.post-entry .entry-content-header {
    display: block !important; 
    text-align: center !important;
    float: none !important;
}

.template-search article.post-entry .post-title {
    margin: 0 !important;
    font-size: 1.2em !important;
}

/* 7. Stacks into a single column on mobile screens */
@media only screen and (max-width: 767px) {
    .template-search article.post-entry {
        width: 100% !important;
        margin-right: 0 !important;
    }
}

/* ADD LOCATION OVERLAY TO POST IMAGES */
/* Hide the badge completely everywhere by default */
.location-badge {
    display: none; 
}

/* ONLY show the badge inside an element with the custom class 'show-location-badges' */
.show-location-badges .location-badge {
    display: block;
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: #333333CC;
    color: #f9f6f0;
    padding: 2px 10px;
    line-height: 1;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 100;
    pointer-events: none; 
    border-radius: 2px;
}

/* Ensure the wrapper anchors the badge correctly */
.show-location-badges .location-badge-wrapper {
    position: relative;
    display: block;
    width: 100%;
}
